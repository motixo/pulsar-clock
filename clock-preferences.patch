+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn hex_colors_support_short_long_and_optional_hash() {
+        for input in ["#FF9500", "ff9500", "  #fF9500  "] {
+            assert_eq!(
+                parse_hex_color(input).unwrap().into_rgba8(),
+                [255, 149, 0, 255]
+            );
+        }
+        assert_eq!(
+            parse_hex_color("#0af").unwrap().into_rgba8(),
+            [0, 170, 255, 255]
+        );
+        assert_eq!(parse_hex_color("000000"), Some(cosmic::iced::Color::BLACK));
+        assert_eq!(parse_hex_color("#fff"), Some(cosmic::iced::Color::WHITE));
+    }
+
+    #[test]
+    fn invalid_and_unicode_colors_are_rejected_without_panicking() {
+        for input in [
+            "",
+            "#",
+            "#12",
+            "#12345",
+            "#1234567",
+            "#GG0000",
+            "red",
+            "##123456",
+            "#12 456",
+            "ییی",
+            "é1234",
+            "#ＦＦＦ",
+            "#1234",
+            "#12345678",
+        ] {
+            assert_eq!(parse_hex_color(input), None, "{input}");
+        }
+    }
+
+    #[test]
+    fn missing_or_invalid_color_uses_the_theme() {
+        let mut config = TimeAppletConfig::default();
+        assert_eq!(panel_color(&config, true), None);
+        config.text_color = Some("#00FF00".into());
+        assert_eq!(
+            panel_color(&config, true).unwrap().into_rgba8(),
+            [0, 255, 0, 255]
+        );
+        config.text_color = Some("invalid".into());
+        assert_eq!(panel_color(&config, true), None);
+        config.text_color = None;
+        assert_eq!(panel_color(&config, true), None);
+    }
+
+    #[test]
+    fn theme_changes_select_independent_colors_without_changing_preferences() {
+        let config = TimeAppletConfig {
+            text_color: Some("#FF9500".into()),
+            text_color_dark: Some("#aef".into()),
+            text_color_light: Some("#153047".into()),
+            ..Default::default()
+        };
+        let saved = config.clone();
+        for is_dark in [true, false, true, false] {
+            let expected = if is_dark {
+                [170, 238, 255, 255]
+            } else {
+                [21, 48, 71, 255]
+            };
+            assert_eq!(
+                panel_color(&config, is_dark).unwrap().into_rgba8(),
+                expected
+            );
+        }
+        assert_eq!(config, saved);
+    }
+
+    #[test]
+    fn legacy_color_applies_to_both_themes_until_each_is_customized() {
+        let mut config = TimeAppletConfig {
+            text_color: Some("#0f0".into()),
+            ..Default::default()
+        };
+        for is_dark in [false, true] {
+            assert_eq!(color_input(&config, is_dark), "#0f0");
+            assert_eq!(
+                panel_color(&config, is_dark).unwrap().into_rgba8(),
+                [0, 255, 0, 255]
+            );
+        }
+        config.text_color_dark = Some("#fff".into());
+        assert_eq!(panel_color(&config, true), Some(cosmic::iced::Color::WHITE));
+        assert_eq!(
+            panel_color(&config, false).unwrap().into_rgba8(),
+            [0, 255, 0, 255]
+        );
+    }
+
+    #[test]
+    fn disabling_custom_colors_keeps_both_choices_for_reenabling() {
+        let mut config = TimeAppletConfig {
+            text_color: None,
+            text_color_dark: Some("#aef".into()),
+            text_color_light: Some("#123".into()),
+            ..Default::default()
+        };
+        for is_dark in [true, false] {
+            assert_eq!(panel_color(&config, is_dark), None);
+        }
+        assert_eq!(color_input(&config, true), "#aef");
+        assert_eq!(color_input(&config, false), "#123");
+        config.text_color = Some(color_input(&config, true));
+        assert_eq!(
+            panel_color(&config, true).unwrap().into_rgba8(),
+            [170, 238, 255, 255]
+        );
+        assert_eq!(
+            panel_color(&config, false).unwrap().into_rgba8(),
+            [17, 34, 51, 255]
+        );
+    }
+
+    #[test]
+    fn defaults_and_invalid_external_values_are_isolated_by_theme() {
+        let mut config = TimeAppletConfig::default();
+        assert_eq!(color_input(&config, true), "#FFFFFF");
+        assert_eq!(color_input(&config, false), "#000000");
+        config.text_color = Some("#fff".into());
+        config.text_color_dark = Some("invalid".into());
+        config.text_color_light = Some("#123".into());
+        assert_eq!(panel_color(&config, true), None);
+        assert_eq!(
+            panel_color(&config, false).unwrap().into_rgba8(),
+            [17, 34, 51, 255]
+        );
+    }
+
+    fn example() -> (TimeAppletConfig, Zoned, Locale) {
+        (
+            TimeAppletConfig {
+                military_time: true,
+                date_time_separator: Some(" | ".into()),
+                ..Default::default()
+            },
+            "2026-10-23T14:05:09+03:30[Asia/Tehran]".parse().unwrap(),
+            "en-US".parse().unwrap(),
+        )
+    }
+
+    #[test]
+    fn custom_separator_and_seconds() {
+        let (mut config, now, locale) = example();
+        assert_eq!(
+            format_panel_datetime(&config, &now, locale.clone()),
+            "Oct 23 | 14:05"
+        );
+        config.show_seconds = true;
+        assert_eq!(
+            format_panel_datetime(&config, &now, locale),
+            "Oct 23 | 14:05:09"
+        );
+    }
+
+    #[test]
+    fn unicode_and_empty_separators_are_literal() {
+        let (mut config, now, locale) = example();
+        config.date_time_separator = Some(" 🌙 · ".into());
+        assert_eq!(
+            format_panel_datetime(&config, &now, locale.clone()),
+            "Oct 23 🌙 · 14:05"
+        );
+        config.date_time_separator = Some(String::new());
+        assert_eq!(format_panel_datetime(&config, &now, locale), "Oct 2314:05");
+    }
+
+    #[test]
+    fn hidden_date_has_no_separator() {
+        let (mut config, now, locale) = example();
+        config.show_date_in_top_panel = false;
+        config.show_seconds = true;
+        assert_eq!(format_panel_datetime(&config, &now, locale), "14:05:09");
+    }
+
+    #[test]
+    fn weekday_and_twelve_hour_time_are_preserved() {
+        let (mut config, now, locale) = example();
+        config.show_weekday = true;
+        assert_eq!(
+            format_panel_datetime(&config, &now, locale.clone()),
+            "Fri, Oct 23 | 14:05"
+        );
+        config.military_time = false;
+        let formatted = format_panel_datetime(&config, &now, locale);
+        assert!(formatted.starts_with("Fri, Oct 23 | 2:05"), "{formatted}");
+        assert!(formatted.ends_with("PM"), "{formatted}");
+    }
+
+    #[test]
+    fn system_separator_can_be_restored() {
+        let (mut config, now, locale) = example();
+        config.date_time_separator = None;
+        assert_eq!(
+            format_panel_datetime(&config, &now, locale),
+            "Oct 23, 14:05"
+        );
+    }
+
+    #[test]
+    fn default_separator_is_a_spaced_bullet() {
+        let (_, now, locale) = example();
+        let config = TimeAppletConfig {
+            military_time: true,
+            ..Default::default()
+        };
+        assert_eq!(
+            format_panel_datetime(&config, &now, locale),
+            "Oct 23 • 14:05"
+        );
+    }
+
+    #[test]
+    fn twelve_and_twenty_four_hour_boundaries() {
+        let (mut config, _, locale) = example();
+        config.show_date_in_top_panel = false;
+        for (hour, expected_24, expected_12) in [
+            ("00", "00:05", "12:05 AM"),
+            ("12", "12:05", "12:05 PM"),
+            ("13", "13:05", "1:05 PM"),
+            ("23", "23:05", "11:05 PM"),
+        ] {
+            let now: Zoned = format!("2026-10-23T{hour}:05:09+03:30[Asia/Tehran]")
+                .parse()
+                .unwrap();
+            config.military_time = true;
+            assert_eq!(
+                format_panel_datetime(&config, &now, locale.clone()),
+                expected_24
+            );
+            config.military_time = false;
+            let formatted = format_panel_datetime(&config, &now, locale.clone());
+            assert_eq!(
+                formatted.split_whitespace().collect::<Vec<_>>().join(" "),
+                expected_12
+            );
+        }
+    }
+
+    #[test]
+    fn legacy_format_keeps_precedence_and_invalid_format_falls_back() {
+        let (mut config, now, locale) = example();
+        config.format_strftime = "%Y-%m-%d => %H:%M".into();
+        assert_eq!(
+            format_panel_datetime(&config, &now, locale.clone()),
+            "2026-10-23 => 14:05"
+        );
+        config.format_strftime = "%".into();
+        assert_eq!(
+            format_panel_datetime(&config, &now, locale),
+            "Oct 23 | 14:05"
+        );
+    }
+}
