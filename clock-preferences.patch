new file mode 100644
index 0000000..92893eb
--- /dev/null
+++ b/cosmic-applet-time/src/presentation.rs
@@ -0,0 +1,396 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+use crate::config::TimeAppletConfig;
+use icu::{
+    datetime::{
+        DateTimeFormatter, DateTimeFormatterPreferences, fieldsets,
+        input::{Date as IcuDate, DateTime, Time},
+        options::TimePrecision,
+    },
+    locale::{Locale, preferences::extensions::unicode::keywords::HourCycle},
+};
+use jiff::{Zoned, civil::Date, fmt::strtime};
+
+pub const DEFAULT_DARK_TEXT_COLOR: &str = "#FFFFFF";
+pub const DEFAULT_LIGHT_TEXT_COLOR: &str = "#000000";
+
+pub fn parse_hex_color(value: &str) -> Option<cosmic::iced::Color> {
+    let value = value.trim();
+    let hex = value.strip_prefix('#').unwrap_or(value);
+    // Validate before calling Iced's byte-indexed parser so Unicode input is safe.
+    if !matches!(hex.len(), 3 | 6) || !hex.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        return None;
+    }
+    hex.parse().ok()
+}
+
+pub fn color_input(config: &TimeAppletConfig, is_dark: bool) -> String {
+    let (color, default) = if is_dark {
+        (&config.text_color_dark, DEFAULT_DARK_TEXT_COLOR)
+    } else {
+        (&config.text_color_light, DEFAULT_LIGHT_TEXT_COLOR)
+    };
+    color
+        .as_ref()
+        .or(config.text_color.as_ref())
+        .map_or_else(|| default.into(), Clone::clone)
+}
+
+pub fn panel_color(config: &TimeAppletConfig, is_dark: bool) -> Option<cosmic::iced::Color> {
+    // Retain the original field as the enable switch and the fallback for
+    // preferences saved before separate light/dark colors were introduced.
+    let legacy = config.text_color.as_deref()?;
+    let color = if is_dark {
+        &config.text_color_dark
+    } else {
+        &config.text_color_light
+    };
+    parse_hex_color(color.as_deref().unwrap_or(legacy))
+}
+
+pub fn create_datetime(date: &Date, now: &Zoned) -> DateTime<icu::calendar::Gregorian> {
+    DateTime {
+        date: IcuDate::try_new_gregorian(date.year() as i32, date.month() as u8, date.day() as u8)
+            .expect("valid date"),
+        time: Time::try_new(now.hour() as u8, now.minute() as u8, now.second() as u8, 0)
+            .expect("valid time"),
+    }
+}
+
+pub fn format_panel_datetime(config: &TimeAppletConfig, now: &Zoned, locale: Locale) -> String {
+    if !config.format_strftime.is_empty()
+        && let Ok(formatted) = strtime::format(&config.format_strftime, now)
+    {
+        return formatted;
+    }
+
+    let datetime = create_datetime(&now.date(), now);
+    let mut prefs = DateTimeFormatterPreferences::from(locale);
+    prefs.hour_cycle = Some(if config.military_time {
+        HourCycle::H23
+    } else {
+        HourCycle::H12
+    });
+
+    let time_fields = if config.show_seconds {
+        fieldsets::T::medium().with_time_precision(TimePrecision::Second)
+    } else {
+        fieldsets::T::medium().with_time_precision(TimePrecision::Minute)
+    };
+
+    if !config.show_date_in_top_panel {
+        return DateTimeFormatter::try_new(prefs, time_fields)
+            .unwrap()
+            .format(&datetime)
+            .to_string();
+    }
+
+    if let Some(separator) = &config.date_time_separator {
+        let date = if config.show_weekday {
+            DateTimeFormatter::try_new(prefs, fieldsets::MDE::medium())
+                .unwrap()
+                .format(&datetime)
+                .to_string()
+        } else {
+            DateTimeFormatter::try_new(prefs, fieldsets::MD::medium())
+                .unwrap()
+                .format(&datetime)
+                .to_string()
+        };
+        let time = DateTimeFormatter::try_new(prefs, time_fields)
+            .unwrap()
+            .format(&datetime)
+            .to_string();
+        return format!("{date}{separator}{time}");
+    }
+
+    // Preserve ICU's locale-specific date/time order and punctuation by default.
+    let precision = if config.show_seconds {
+        TimePrecision::Second
+    } else {
+        TimePrecision::Minute
+    };
+    if config.show_weekday {
+        DateTimeFormatter::try_new(
+            prefs,
+            fieldsets::MDET::medium().with_time_precision(precision),
+        )
+        .unwrap()
+        .format(&datetime)
+        .to_string()
+    } else {
+        DateTimeFormatter::try_new(
+            prefs,
+            fieldsets::MDT::medium().with_time_precision(precision),
+        )
+        .unwrap()
+        .format(&datetime)
+        .to_string()
+    }
+}
